{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Usage Monitor",
  "version": "1.8.5",
  "identifier": "com.kosa.claude-usage-monitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "widget",
        "url": "/widget.html",
        "title": "Claude Usage",
        "width": 280,
        "height": 250,
        "minWidth": 220,
        "minHeight": 54,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "center": false,
        "x": 1640,
        "y": 920
      },
      {
        "label": "settings",
        "url": "/settings.html",
        "title": "Claude Usage Monitor — Settings",
        "width": 480,
        "height": 580,
        "resizable": false,
        "visible": false,
        "center": true
      },
      {
        "label": "statistics",
        "url": "/statistics.html",
        "title": "Claude Usage Monitor — 統計",
        "width": 1300,
        "height": 840,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Kosa (TipsyDrifter)",
    "copyright": "Copyright (c) 2026 Kosa (TipsyDrifter). MIT License. Not affiliated with Anthropic.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/TipsyDrifter/claude-usage-monitor",
    "shortDescription": "Claude 訂閱額度監控：系統匣＋懸浮窗，並把每次真值記進帳本",
    "longDescription": "住在 Windows 系統匣裡的小工具：不用開分頁就看得到 Claude 訂閱額度還剩多少，並把每一次讀到的真值記進本機帳本。只讀官方 CLI 與 Claude Desktop 的本機檔案，不爬網頁、不碰憑證。非官方工具，與 Anthropic 無關。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
